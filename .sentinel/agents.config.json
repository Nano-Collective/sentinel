{
	"nanocoder": {
		"autoCompact": {
			"threshold": 90
		},
		"disabledTools": [
			"execute_bash",
			"fetch_url",
			"web_search",
			"agent",
			"file_op",
			"write_file",
			"string_replace",
			"diff_edit",
			"git_add",
			"git_commit",
			"git_pr",
			"ask_user"
		],
		"providers": [
			{
				"name": "MiniMax Coding",
				"sdkProvider": "anthropic",
				"baseUrl": "https://api.minimax.io/anthropic/v1",
				"apiKey": "${MINIMAX_API_KEY}",
				"models": ["minimax-m3"],
				"maxOutputTokens": 32000
			}
		]
	}
}
